{
  "name": "gifdoc-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Automated demo GIF generator for GitHub READMEs",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "clean": "npm run clean --workspaces && rm -rf node_modules"
  },
  "keywords": [
    "gif",
    "demo",
    "playwright",
    "automation",
    "documentation"
  ],
  "author": "YS",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
